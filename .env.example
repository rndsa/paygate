# ===== PayGate Environment =====
# Server
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# BASE_URL=https://pay.example.com

# ===== Security =====
# Ganti dengan random 64-hex! (bisa generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COOKIE_SECRET=REPLACE_WITH_RANDOM_64_HEX
# Durasi session (jam)
SESSION_TTL_HOURS=168
# Rate limit global
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MIN=15
# Login brute force
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15
# Set true kalau dibelakang reverse proxy (nginx/CF)
TRUST_PROXY=false

# ===== Encryption at rest (kredensial ShopeePay/GoPay) =====
# 64-hex key. Kalau dikosongin, otomatis generate & simpan di data/secret.key
# ENCRYPTION_KEY=

# ===== Payment / polling =====
# Live-only: disconnected accounts cannot create orders. No provider default.
# Exact amount matching; payment tolerance is always zero.
ORDER_TTL_MINUTES=30

# ===== LAB unofficial — OFF by default; NOT an official sandbox =====
# QRIS can transfer REAL funds. Own merchant account only; unsupported/ToS risk.
# Required explicit positive integer app user ID; never defaults to an owner.
LAB_UNOFFICIAL=0
LAB_USER_ID=
# Minimum 30000ms. Real merchant feed polling only.
LAB_POLL_INTERVAL_MS=60000
# Server only. Never paste tokens in chat, browser forms, logs, or Git.
GOPAY_ACCESS_TOKEN=
GOPAY_MERCHANT_ID=
GOPAY_QRIS_STATIC=
SHOPEEPAY_TOKEN=
SHOPEEPAY_MERCHANT_ID=
SHOPEEPAY_STORE_ID=
SHOPEEPAY_QRIS_STATIC=
