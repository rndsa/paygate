<div class="fade-up">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Ringkasan</p>
      <h1>Ringkasan</h1>
      <p class="page-description">Lihat tagihan terbaru, uang yang sudah masuk, dan status akun pembayaran kamu.</p>
    </div>
  </div>

  <!-- Stat cards -->
  <div class="grid grid-4 mb-16" id="statCards">
    <div class="stat"><div class="muted small">Memuat ringkasan…</div></div>
    <div class="stat"><div class="muted small">Memuat ringkasan…</div></div>
    <div class="stat"><div class="muted small">Memuat ringkasan…</div></div>
    <div class="stat"><div class="muted small">Memuat ringkasan…</div></div>
